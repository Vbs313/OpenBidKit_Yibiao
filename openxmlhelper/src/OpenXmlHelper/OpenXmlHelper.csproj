<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>openxmlhelper</AssemblyName>
    <RootNamespace>Yibiao.OpenXmlHelper</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- 本机 NuGet restore 不可用时走本地 lib 引用；包版本与 数据集团工具箱 对齐。 -->
    <Reference Include="DocumentFormat.OpenXml">
      <HintPath>..\..\lib\DocumentFormat.OpenXml.dll</HintPath>
    </Reference>
    <Reference Include="DocumentFormat.OpenXml.Framework">
      <HintPath>..\..\lib\DocumentFormat.OpenXml.Framework.dll</HintPath>
    </Reference>
    <Reference Include="HtmlToOpenXml">
      <HintPath>..\..\lib\HtmlToOpenXml.dll</HintPath>
    </Reference>
    <Reference Include="AngleSharp">
      <HintPath>..\..\lib\AngleSharp.dll</HintPath>
    </Reference>
    <Reference Include="AngleSharp.Css">
      <HintPath>..\..\lib\AngleSharp.Css.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>..\..\lib\Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
    </Reference>
    <Reference Include="System.IO.Packaging">
      <HintPath>..\..\lib\System.IO.Packaging.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
