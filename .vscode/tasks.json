{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "安装依赖 (npm ci)",
      "type": "shell",
      "command": "npm ci",
      "options": { "cwd": "${workspaceFolder}/client" },
      "problemMatcher": []
    },
    {
      "label": "开发模式 (npm run dev)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/client" },
      "presentation": { "reveal": "always", "panel": "new" },
      "problemMatcher": []
    },
    {
      "label": "构建 (npm run build)",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/client" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "单元测试 (npm test)",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/client" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Electron ABI 测试 (test:electron-abi)",
      "type": "shell",
      "command": "npm run test:electron-abi",
      "options": { "cwd": "${workspaceFolder}/client" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "结构门禁 (verify:module-graph)",
      "type": "shell",
      "command": "npm run verify:module-graph",
      "options": { "cwd": "${workspaceFolder}/client" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "冒烟：页面挂载",
      "type": "shell",
      "command": "npm run smoke:pages-mount",
      "options": { "cwd": "${workspaceFolder}/client" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "冒烟：IPC 启动",
      "type": "shell",
      "command": "npm run smoke:ipc-boot",
      "options": { "cwd": "${workspaceFolder}/client" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "冒烟：原生依赖 / Schema",
      "type": "shell",
      "command": "npm run smoke:electron-native && npm run smoke:schema",
      "options": { "cwd": "${workspaceFolder}/client" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "打包 Windows (dist:win)",
      "type": "shell",
      "command": "npm run dist:win",
      "options": { "cwd": "${workspaceFolder}/client" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "打包 macOS (dist:mac)",
      "type": "shell",
      "command": "npm run dist:mac",
      "options": { "cwd": "${workspaceFolder}/client" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
